# Copy to .env and adjust. .env is git-ignored.

# PostgreSQL connection string. Matches docker-compose.yml defaults.
PG_DSN=postgres://waterloostar:waterloostar@localhost:5433/waterloostar?sslmode=disable

# Port the API listens on.
PORT=8080

# Origin allowed to make credentialed cross-origin requests.
# The Next.js dev server in WaterlooStar-Frontend.
CORS_ORIGIN=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info

# development | production
# Controls whether the session cookie is marked Secure (Phase 1).
ENVIRONMENT=development

# Signs access tokens. Generate with: openssl rand -base64 48
# Rotating it invalidates every live session.
JWT_SECRET=dev-only-secret-not-for-production-use-abc123

# Frontend origin, used to build the links that go into emails.
# Defaults to CORS_ORIGIN when unset.
APP_URL=http://localhost:3000
